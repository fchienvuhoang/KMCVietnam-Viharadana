# PostgreSQL connection string from Vercel Storage / Vercel Marketplace.
# Example formats:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL=""

# Maximum PostgreSQL connections per application instance. Keep this low on serverless hosting.
DATABASE_POOL_MAX="2"

# Optional: canonical public URL for shared campaign links. Leave blank to use the current website.
NEXT_PUBLIC_APP_URL=""

# Required for the private admin dashboard. Public campaign pages do not need login.
# Generate a strong value, for example: openssl rand -base64 32
ADMIN_PASSWORD=""

# Fixed password for the read-only report at /bao-cao. Minimum 8 characters.
READONLY_VIEW_PASSWORD=""
